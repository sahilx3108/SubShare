# --- Database ---
DATABASE_URL="postgresql://subshare:subshare@localhost:5432/subshare?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Next.js app)
WEB_ORIGIN=http://localhost:3000
# Public URL of this API (used in verification emails)
PUBLIC_API_URL=http://localhost:4000

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# --- Razorpay (Test mode keys from dashboard.razorpay.com) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=test-secret
# Webhook secret configured in the Razorpay dashboard webhook settings
RAZORPAY_WEBHOOK_SECRET=webhook-secret

# --- App behavior ---
# In development, verification links are returned in API responses and logged.
RETURN_DEV_VERIFY_LINK=true
